{
  "headers": [
    {
      "source": "/zb_users/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/(.*)/index.html", "destination": "/$1/", "permanent": true }
  ]
}
